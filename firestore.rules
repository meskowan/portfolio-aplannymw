rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'GANTI_DENGAN_EMAIL_ADMIN_ANDA';
    }
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
